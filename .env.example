# StudentHub Environment Configuration Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to GitHub.

# Database Connections (Optional Serverless Database)
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Client Credentials (Optional Cloud Storage/Auth)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-PUBLIC-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-PRIVATE-KEY]"

# Admin Secret Key (Used for protecting /api/admin/* endpoints)
ADMIN_SECRET_KEY="[YOUR-SECURE-ADMIN-TOKEN]"

# Node Environment
NODE_ENV="development"
